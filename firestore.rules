rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kullanıcı profilleri kuralları:
    // Sadece giriş yapmış kullanıcılar kendi verilerini okuyabilir ve güncelleyebilir.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sistem sayaçları kuralları:
    // Herkes toplam sayaç değerlerini görebilir.
    // Oturum sayacının artırılmasına (update) izin verilir, ancak döküman tamamen silinemez veya rastgele alan eklenemez.
    match /system/counters {
      allow read: if true;
      allow update: if request.resource.data.totalLogins is int 
                   && request.resource.data.totalLogins == resource.data.totalLogins + 1;
      allow create, delete: if false;
    }
  }
}
